{
    "manifest_version": 3,
    "name": "Start Tab",
    "version": "1.3.0",
    "description": "New tab page for a faster more private browser experience.",
    "author": "Jonathan Crocker",
    "offline_enabled": true,
    "permissions" : [
        "bookmarks",
        "favicon"
    ],
    "chrome_url_overrides" : {
        "newtab": "index.html"
    },
    "background" : {
        "service_worker": "background.js"
    },
    "action": {
    },
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "64": "icon64.png",
        "128": "icon128.png"
    }
 }
